# =============================================================================
# built-app — the ship fixture's environment template
# =============================================================================
# Rendered into <apps>/built-app/.env on the VPS. No KASBAH_* key is declared
# here: kasbah owns that prefix and injects the resource limits itself
# (docs/env-template.md, docs/compliance.md → E05).

BUILT_APP_GREETING=hello from the built-app fixture
BUILT_APP_CACHE_TTL=60
