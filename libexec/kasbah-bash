#!/usr/bin/env bash
# kasbah — multi-project Docker host CLI. See docs/ for design.
# The Bash half: the Go `kasbah` execs this for every command it does not own.

set -euo pipefail

_resolve_self_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

_self_dir="$(_resolve_self_dir)"

# A checkout is recognised by the install.sh sibling of libexec/ — unambiguous,
# and the same test decides where both the libraries and the templates come from.
_repo_dir=""
if [ -f "$_self_dir/../install.sh" ] && [ -f "$_self_dir/../VERSION" ]; then
    _repo_dir="$(cd "$_self_dir/.." && pwd)"
fi

# Prefer an explicit override, else a repo checkout, else the XDG share dir.
_lib_dir_given="${KASBAH_LIB_DIR:+1}"
if [ -n "${KASBAH_LIB_DIR:-}" ]; then
    KASBAH_VERSION_FILE="$KASBAH_LIB_DIR/VERSION"
elif [ -n "$_repo_dir" ]; then
    KASBAH_LIB_DIR="$_repo_dir/lib"
    KASBAH_VERSION_FILE="$_repo_dir/VERSION"
else
    if [ -z "${XDG_DATA_HOME:-}" ] && [ -z "${HOME:-}" ]; then
        echo "kasbah: neither KASBAH_LIB_DIR, XDG_DATA_HOME, nor HOME is set" >&2
        exit 1
    fi
    KASBAH_LIB_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/kasbah"
    KASBAH_VERSION_FILE="$KASBAH_LIB_DIR/VERSION"
fi

if [ ! -f "$KASBAH_LIB_DIR/common.sh" ]; then
    echo "kasbah: cannot locate library files (looked in $KASBAH_LIB_DIR)" >&2
    exit 1
fi

# Templates are rendered onto servers, so an installed kasbah must carry its
# own copy: install.sh puts the tree beside the libraries. They travel with the
# libraries — whoever names the library directory names the templates too, so a
# KASBAH_LIB_DIR pointing at an installed tree cannot end up pairing installed
# libraries with a checkout's templates. Only KASBAH_TEMPLATE_DIR splits them,
# and only on purpose.
if [ -z "${KASBAH_TEMPLATE_DIR:-}" ]; then
    if [ -n "$_lib_dir_given" ] || [ -z "$_repo_dir" ]; then
        KASBAH_TEMPLATE_DIR="$KASBAH_LIB_DIR/templates"
    else
        KASBAH_TEMPLATE_DIR="$_repo_dir/templates"
    fi
fi

# shellcheck source=../lib/common.sh
. "$KASBAH_LIB_DIR/common.sh"

KASBAH_VERSION="$(cat "$KASBAH_VERSION_FILE")"
# What --version and the usage print: the Go binary's build stamp (VERSION plus
# a build counter), or VERSION itself when this file runs on its own. Files
# kasbah writes record KASBAH_VERSION, never the stamp.
KASBAH_BUILD="${KASBAH_BUILD:-$KASBAH_VERSION}"
export KASBAH_LIB_DIR KASBAH_TEMPLATE_DIR KASBAH_VERSION

usage() {
    cat <<EOF
kasbah — multi-project Docker host CLI (v$KASBAH_BUILD)

Usage: kasbah [--version] [--help] <command> [args...]

Commands:
  init-project [--name=<n>] [--domain=<d>]   Scaffold kasbah metadata in cwd.
  check [--server [USER@HOST]] [--fix]       Run structural checks on the project, optionally against a server; --fix repairs what it can.
  build-push [USER@HOST]                     Build this project's images and load them on a server.
  deploy [USER@HOST] [VERSION]               Ship the working tree, or a tagged version, and bring it up.
  rollback [USER@HOST] [VERSION]             Put a server back on a version it has already run.
  drop [USER@HOST] [--prune]                 Remove this project from a server.
  history [USER@HOST] [--all]                Show a server's deploy record for this project.
  pending [USER@HOST] [VERSION]              Show the commits a deploy would ship.
  changelog [USER@HOST]                      Show what changed in the deployed version.
  env [USER@HOST]                            Render the project's .env on the server.
  logs [USER@HOST] [SERVICE] [-f] [--tail=N] Show this project's container logs on a server.
  exec [USER@HOST] SERVICE -- CMD...         Run a command in one of this project's containers.
  server init USER@HOST [flags]              Prepare a VPS to host projects.
  server status USER@HOST                    Report what a prepared VPS is running.
  server prune USER@HOST [--yes]             Remove image tags outside the retention window.
  server backup-prune USER@HOST              Apply the retention policy to the server's restic repositories.
  server destroy USER@HOST [--yes]           De-brand a VPS for handover; every container keeps running.
  server add-mail-domain USER@HOST DOMAIN    Join a domain to the VPS's shared mail stack.
  server mail-setup-guide USER@HOST          Print the mail stack's setup walkthrough.
  server upgrade-traefik USER@HOST --version=<tag>
                                             Dry-run the fragments against a Traefik version, then switch.

See docs/cli.md for the full planned surface.
EOF
}

# `kasbah server …` acts on a VPS and always takes USER@HOST; everything else
# acts on the project in the current directory (docs/cli.md).
dispatch_server() {
    local sub="${1:-}"
    [ $# -eq 0 ] || shift
    case "$sub" in
        init)
            . "$KASBAH_LIB_DIR/server_init.sh"
            cmd_server_init "$@"
            ;;
        backup-prune)
            . "$KASBAH_LIB_DIR/backup.sh"
            cmd_server_backup_prune "$@"
            ;;
        destroy)
            . "$KASBAH_LIB_DIR/server_destroy.sh"
            cmd_server_destroy "$@"
            ;;
        -h|--help)
            cat <<EOF
Usage: kasbah server <subcommand> USER@HOST [args...]

Subcommands:
  init USER@HOST [flags]   Prepare a VPS to host projects.
  status USER@HOST         Report what a prepared VPS is running (read-only).
  prune USER@HOST [--yes]  Remove <image>:<version> tags older than 3 months and
                           outside each project's last 3 deployed versions.
  backup-prune USER@HOST   Apply the retention policy to this server's restic
                           repositories. restic runs here, not on the VPS: the
                           full-access credential never goes to the server.
  destroy USER@HOST [--yes]
                           De-brand a VPS for handover: the marker, the backup
                           stack and its credentials, each project's deploy
                           record and helpers, and the mail relay block. Every
                           container keeps running.
  upgrade-traefik USER@HOST --version=<tag>
                           Move the shared Traefik to another image tag: backs
                           up the three kasbah-owned files and dry-runs every
                           dynamic fragment against the target version first.
  add-mail-domain USER@HOST DOMAIN
                           Join a domain to the shared mail stack (docs/mail.md).
  mail-setup-guide USER@HOST
                           Print the mail stack's setup walkthrough (read-only).

Run \`kasbah server <subcommand> --help\` for its flags.
EOF
            ;;
        '')
            die "server: no subcommand given (expected: init, status, prune, backup-prune, destroy, upgrade-traefik, add-mail-domain, mail-setup-guide)"
            ;;
        *)
            die "server: unknown subcommand '$sub' (expected: init, status, prune, backup-prune, destroy, upgrade-traefik, add-mail-domain, mail-setup-guide)"
            ;;
    esac
}

dispatch() {
    local cmd="$1"; shift
    case "$cmd" in
        init-project)
            . "$KASBAH_LIB_DIR/init_project.sh"
            cmd_init_project "$@"
            ;;
        drop)
            . "$KASBAH_LIB_DIR/drop.sh"
            cmd_drop "$@"
            ;;
        server)
            dispatch_server "$@"
            ;;
        *)
            die "command '$cmd' is not yet implemented"
            ;;
    esac
}

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    case "$1" in
        -v|--version) echo "kasbah $KASBAH_BUILD" ;;
        -h|--help)    usage ;;
        *)            dispatch "$@" ;;
    esac
}

main "$@"
