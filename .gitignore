.DS_Store
*.swp
*~
.env

# Rig keypair — generated per checkout by tests/rig/rig.sh, never committed.
tests/rig/id_ed25519
tests/rig/id_ed25519.pub
# Rig ssh config — regenerated per invocation; embeds the resolved port and key
# path. The glob also covers the mktemp file it is renamed from.
tests/rig/ssh_config*
# Rig backup endpoints — regenerated by tests/rig/rig.sh up; holds the
# rest-server addresses and credentials read back out of the containers.
tests/rig/backup_env.sh*

# Go build output (docker compose run --rm build) and the toolchain's caches,
# kept in the tree so the unprivileged build container can write them.
/dist/
/.cache/

# Claude Code's per-checkout settings. Also in many a global excludes file, but
# the build container's git cannot see that one, and an untracked file would
# stamp every build dirty.
**/.claude/settings.local.json
