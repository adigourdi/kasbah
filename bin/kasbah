#!/usr/bin/env bash
# kasbah — multi-project Docker host CLI. See docs/ for design.

set -euo pipefail

_resolve_self_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

_bin_dir="$(_resolve_self_dir)"

# A checkout is recognised by the install.sh sibling — unambiguous, and the
# same test decides where both the libraries and the templates come from.
_repo_dir=""
if [ -f "$_bin_dir/../install.sh" ] && [ -f "$_bin_dir/../VERSION" ]; then
    _repo_dir="$(cd "$_bin_dir/.." && pwd)"
fi

# Prefer an explicit override, else a repo checkout, else the XDG share dir.
_lib_dir_given="${KASBAH_LIB_DIR:+1}"
if [ -n "${KASBAH_LIB_DIR:-}" ]; then
    KASBAH_VERSION_FILE="$KASBAH_LIB_DIR/VERSION"
elif [ -n "$_repo_dir" ]; then
    KASBAH_LIB_DIR="$_repo_dir/lib"
    KASBAH_VERSION_FILE="$_repo_dir/VERSION"
else
    if [ -z "${XDG_DATA_HOME:-}" ] && [ -z "${HOME:-}" ]; then
        echo "kasbah: neither KASBAH_LIB_DIR, XDG_DATA_HOME, nor HOME is set" >&2
        exit 1
    fi
    KASBAH_LIB_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/kasbah"
    KASBAH_VERSION_FILE="$KASBAH_LIB_DIR/VERSION"
fi

if [ ! -f "$KASBAH_LIB_DIR/common.sh" ]; then
    echo "kasbah: cannot locate library files (looked in $KASBAH_LIB_DIR)" >&2
    exit 1
fi

# Templates are rendered onto servers, so an installed kasbah must carry its
# own copy: install.sh puts the tree beside the libraries. They travel with the
# libraries — whoever names the library directory names the templates too, so a
# KASBAH_LIB_DIR pointing at an installed tree cannot end up pairing installed
# libraries with a checkout's templates. Only KASBAH_TEMPLATE_DIR splits them,
# and only on purpose.
if [ -z "${KASBAH_TEMPLATE_DIR:-}" ]; then
    if [ -n "$_lib_dir_given" ] || [ -z "$_repo_dir" ]; then
        KASBAH_TEMPLATE_DIR="$KASBAH_LIB_DIR/templates"
    else
        KASBAH_TEMPLATE_DIR="$_repo_dir/templates"
    fi
fi

# shellcheck source=../lib/common.sh
. "$KASBAH_LIB_DIR/common.sh"

KASBAH_VERSION="$(cat "$KASBAH_VERSION_FILE")"
export KASBAH_LIB_DIR KASBAH_TEMPLATE_DIR KASBAH_VERSION

usage() {
    cat <<EOF
kasbah — multi-project Docker host CLI (v$KASBAH_VERSION)

Usage: kasbah [--version] [--help] <command> [args...]

Commands:
  init-project [--name=<n>] [--domain=<d>]   Scaffold kasbah metadata in cwd.
  check                                      Run structural checks on the project.
  build-push [USER@HOST]                     Build this project's images and load them on a server.
  deploy [USER@HOST] [VERSION]               Ship the working tree, or a tagged version, and bring it up.
  rollback [USER@HOST] [VERSION]             Put a server back on a version it has already run.
  history [USER@HOST] [--all]                Show a server's deploy record for this project.
  pending [USER@HOST] [VERSION]              Show the commits a deploy would ship.
  changelog [USER@HOST]                      Show what changed in the deployed version.
  env [USER@HOST]                            Render the project's .env on the server.
  logs [USER@HOST] [SERVICE] [-f] [--tail=N] Show this project's container logs on a server.
  exec [USER@HOST] SERVICE -- CMD...         Run a command in one of this project's containers.
  server init USER@HOST [flags]              Prepare a VPS to host projects.
  server status USER@HOST                    Report what a prepared VPS is running.

See docs/cli.md for the full planned surface.
EOF
}

# `kasbah server …` acts on a VPS and always takes USER@HOST; everything else
# acts on the project in the current directory (docs/cli.md).
dispatch_server() {
    local sub="${1:-}"
    [ $# -eq 0 ] || shift
    case "$sub" in
        init)
            . "$KASBAH_LIB_DIR/server_init.sh"
            cmd_server_init "$@"
            ;;
        status)
            . "$KASBAH_LIB_DIR/server_status.sh"
            cmd_server_status "$@"
            ;;
        -h|--help)
            cat <<EOF
Usage: kasbah server <subcommand> USER@HOST [args...]

Subcommands:
  init USER@HOST [flags]   Prepare a VPS to host projects.
  status USER@HOST         Report what a prepared VPS is running (read-only).

Run \`kasbah server <subcommand> --help\` for its flags.
EOF
            ;;
        '')
            die "server: no subcommand given (expected: init, status)"
            ;;
        *)
            die "server: unknown subcommand '$sub' (expected: init, status)"
            ;;
    esac
}

dispatch() {
    local cmd="$1"; shift
    case "$cmd" in
        init-project)
            . "$KASBAH_LIB_DIR/init_project.sh"
            cmd_init_project "$@"
            ;;
        check)
            . "$KASBAH_LIB_DIR/check.sh"
            cmd_check "$@"
            ;;
        build-push)
            . "$KASBAH_LIB_DIR/build_push.sh"
            cmd_build_push "$@"
            ;;
        deploy)
            . "$KASBAH_LIB_DIR/deploy.sh"
            cmd_deploy "$@"
            ;;
        rollback)
            . "$KASBAH_LIB_DIR/rollback.sh"
            cmd_rollback "$@"
            ;;
        history|pending|changelog)
            . "$KASBAH_LIB_DIR/history.sh"
            "cmd_$cmd" "$@"
            ;;
        env)
            . "$KASBAH_LIB_DIR/env_cmd.sh"
            cmd_env "$@"
            ;;
        logs|exec)
            . "$KASBAH_LIB_DIR/ops.sh"
            "cmd_$cmd" "$@"
            ;;
        server)
            dispatch_server "$@"
            ;;
        *)
            die "command '$cmd' is not yet implemented"
            ;;
    esac
}

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    case "$1" in
        -v|--version) echo "kasbah $KASBAH_VERSION" ;;
        -h|--help)    usage ;;
        *)            dispatch "$@" ;;
    esac
}

main "$@"
