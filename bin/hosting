#!/usr/bin/env bash
# hosting — multi-project Docker host CLI. See docs/ for design.

set -euo pipefail

_resolve_self_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

_bin_dir="$(_resolve_self_dir)"

# A checkout is recognised by the install.sh sibling — unambiguous, and the
# same test decides where both the libraries and the templates come from.
_repo_dir=""
if [ -f "$_bin_dir/../install.sh" ] && [ -f "$_bin_dir/../VERSION" ]; then
    _repo_dir="$(cd "$_bin_dir/.." && pwd)"
fi

# Prefer an explicit override, else a repo checkout, else the XDG share dir.
_lib_dir_given="${HOSTING_LIB_DIR:+1}"
if [ -n "${HOSTING_LIB_DIR:-}" ]; then
    HOSTING_VERSION_FILE="$HOSTING_LIB_DIR/VERSION"
elif [ -n "$_repo_dir" ]; then
    HOSTING_LIB_DIR="$_repo_dir/lib"
    HOSTING_VERSION_FILE="$_repo_dir/VERSION"
else
    if [ -z "${XDG_DATA_HOME:-}" ] && [ -z "${HOME:-}" ]; then
        echo "hosting: neither HOSTING_LIB_DIR, XDG_DATA_HOME, nor HOME is set" >&2
        exit 1
    fi
    HOSTING_LIB_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/hosting"
    HOSTING_VERSION_FILE="$HOSTING_LIB_DIR/VERSION"
fi

if [ ! -f "$HOSTING_LIB_DIR/common.sh" ]; then
    echo "hosting: cannot locate library files (looked in $HOSTING_LIB_DIR)" >&2
    exit 1
fi

# Templates are rendered onto servers, so an installed hosting must carry its
# own copy: install.sh puts the tree beside the libraries. They travel with the
# libraries — whoever names the library directory names the templates too, so a
# HOSTING_LIB_DIR pointing at an installed tree cannot end up pairing installed
# libraries with a checkout's templates. Only HOSTING_TEMPLATE_DIR splits them,
# and only on purpose.
if [ -z "${HOSTING_TEMPLATE_DIR:-}" ]; then
    if [ -n "$_lib_dir_given" ] || [ -z "$_repo_dir" ]; then
        HOSTING_TEMPLATE_DIR="$HOSTING_LIB_DIR/templates"
    else
        HOSTING_TEMPLATE_DIR="$_repo_dir/templates"
    fi
fi

# shellcheck source=../lib/common.sh
. "$HOSTING_LIB_DIR/common.sh"

HOSTING_VERSION="$(cat "$HOSTING_VERSION_FILE")"
export HOSTING_LIB_DIR HOSTING_TEMPLATE_DIR HOSTING_VERSION

usage() {
    cat <<EOF
hosting — multi-project Docker host CLI (v$HOSTING_VERSION)

Usage: hosting [--version] [--help] <command> [args...]

Commands:
  init-project [--name=<n>] [--domain=<d>]   Scaffold hosting metadata in cwd.
  check                                      Run structural checks on the project.
  server init USER@HOST [flags]              Prepare a VPS to host projects.

See docs/cli.md for the full planned surface.
EOF
}

# `hosting server …` acts on a VPS and always takes USER@HOST; everything else
# acts on the project in the current directory (docs/cli.md).
dispatch_server() {
    local sub="${1:-}"
    [ $# -eq 0 ] || shift
    case "$sub" in
        init)
            . "$HOSTING_LIB_DIR/server_init.sh"
            cmd_server_init "$@"
            ;;
        -h|--help)
            cat <<EOF
Usage: hosting server <subcommand> USER@HOST [args...]

Subcommands:
  init USER@HOST [flags]   Prepare a VPS to host projects.

Run \`hosting server init --help\` for its flags.
EOF
            ;;
        '')
            die "server: no subcommand given (expected: init)"
            ;;
        *)
            die "server: unknown subcommand '$sub' (expected: init)"
            ;;
    esac
}

dispatch() {
    local cmd="$1"; shift
    case "$cmd" in
        init-project)
            . "$HOSTING_LIB_DIR/init_project.sh"
            cmd_init_project "$@"
            ;;
        check)
            . "$HOSTING_LIB_DIR/check.sh"
            cmd_check "$@"
            ;;
        server)
            dispatch_server "$@"
            ;;
        *)
            die "command '$cmd' is not yet implemented"
            ;;
    esac
}

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    case "$1" in
        -v|--version) echo "hosting $HOSTING_VERSION" ;;
        -h|--help)    usage ;;
        *)            dispatch "$@" ;;
    esac
}

main "$@"
