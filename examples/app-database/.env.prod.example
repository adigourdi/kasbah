# =============================================================================
# reader — production configuration
# =============================================================================
# Asked for on the first deploy, kept in the server's .env afterwards.

# --- App ---
APP_URL=https://reader.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=! docker run --rm alpine sh -c 'tr -dc A-Za-z0-9 </dev/urandom | head -c 24'

# --- Database ---
# Generated once; postgres takes it on its first start only.
DB_PASSWORD=! docker run --rm alpine sh -c 'tr -dc A-Za-z0-9 </dev/urandom | head -c 32'
