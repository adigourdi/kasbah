# =============================================================================
# git — production configuration
# =============================================================================

APP_URL=https://git.example.com/

# --- Mail ---
# The mail stack's public hostname and submission port (STARTTLS).
MAIL_HOST=mail.example.com
MAIL_PORT=587
# A mailbox on the stack, made by the server's admin for this app.
MAIL_USER=noreply@example.com
MAIL_PASSWORD=# The mailbox's password
MAIL_FROM=Git <noreply@example.com>
